:root {
    --bg: #f3efe8;
    --ink: #201b16;
    --ink-soft: #6e6357;
    --panel: rgba(255, 255, 255, 0.76);
    --line: rgba(32, 27, 22, 0.16);
    --accent: #c6522f;
    --accent-soft: #ffcfbd;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: 'Space Grotesk', sans-serif;
    color: var(--ink);
    background:
        radial-gradient(circle at 10% 10%, #ffe0c8 0%, transparent 35%),
        radial-gradient(circle at 90% 90%, #ffd8cd 0%, transparent 40%),
        var(--bg);
    height: 100vh;
    overflow: hidden;
}

.editor-app {
    height: 100vh;
    display: grid;
    grid-template-columns: 360px 1fr;
}

.track-panel {
    border-right: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.58);
    backdrop-filter: blur(8px);
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 0;
}

.panel-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
}

.panel-title-row {
    display: flex;
    align-items: center;
    gap: 8px;
}

.panel-head h1 {
    margin: 0;
    font-size: 20px;
}

.help-btn {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--accent);
    font-weight: 700;
    cursor: pointer;
}

.back-link {
    text-decoration: none;
    color: var(--accent);
    font-weight: 700;
}

.search {
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 8px 10px;
    font-size: 14px;
    background: white;
}

.editor-tools {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
}

.track-list {
    overflow: auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 0;
}

.playlist-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: #fff;
    cursor: pointer;
    position: relative;
}

.playlist-item.active {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--accent-soft);
}

.playlist-item-art {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: #f7f1eb;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.playlist-item-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.playlist-item-art .material-icons-round {
    font-size: 20px;
    color: #8a7f73;
}

.playlist-item-info {
    flex: 1;
    min-width: 0;
}

.playlist-item-title {
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.playlist-item-artist {
    font-size: 12px;
    color: var(--ink-soft);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-top: 2px;
}

.playlist-item-duration {
    font-size: 12px;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
}

.edit-panel {
    padding: 12px;
    display: grid;
    grid-template-rows: auto auto;
    gap: 10px;
    align-content: start;
    overflow: auto;
}

.form-card,
.viz-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 12px;
}

.form-card h2 {
    margin: 0;
}

.path {
    margin: 4px 0 8px;
    color: var(--ink-soft);
    font-size: 13px;
    word-break: break-all;
}

.artwork-edit-row {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 10px;
    margin-bottom: 10px;
}

.artwork-preview-wrap {
    position: relative;
    width: 120px;
    height: 120px;
    border-radius: 10px;
    border: 1px solid var(--line);
    overflow: hidden;
    background: #fff;
}

.artwork-preview {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: none;
}

.artwork-empty {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--ink-soft);
    font-size: 12px;
}

.artwork-actions {
    display: flex;
    flex-direction: column;
    gap: 6px;
    justify-content: center;
}

.soft-btn {
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #fff;
    color: var(--ink);
    font-weight: 600;
    font-size: 13px;
    padding: 8px 10px;
    cursor: pointer;
}

.soft-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.artwork-note {
    margin: 2px 0 0;
    font-size: 11px;
    color: var(--ink-soft);
}

.grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(240px, 1fr));
    gap: 8px;
}

label {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 12px;
    color: var(--ink-soft);
    font-weight: 600;
}

input {
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 8px 10px;
    font-size: 13px;
    font-family: inherit;
    color: var(--ink);
    background: white;
}

.save-btn {
    margin-top: 8px;
    border: none;
    border-radius: 12px;
    background: var(--accent);
    color: white;
    font-weight: 700;
    font-size: 14px;
    padding: 8px 14px;
    cursor: pointer;
}

.save-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.status {
    min-height: 20px;
    margin: 6px 0 0;
    font-size: 13px;
    color: var(--ink-soft);
}

.viz-card h3 {
    margin: 0 0 8px;
}

.metric-row {
    display: grid;
    grid-template-columns: repeat(6, minmax(100px, 1fr));
    gap: 8px;
    margin-bottom: 8px;
}

.metric {
    border: 1px solid var(--line);
    background: white;
    border-radius: 10px;
    padding: 6px;
}

.metric span {
    font-size: 11px;
    color: var(--ink-soft);
    display: block;
}

.metric strong {
    font-size: 14px;
}

#techChart {
    width: 100%;
    border-radius: 12px;
    background: #fff;
    border: 1px solid var(--line);
    height: 140px;
}

.help-panel {
    position: fixed;
    inset: 0;
    background: rgba(20, 17, 14, 0.35);
    display: grid;
    place-items: center;
    z-index: 50;
}

.help-panel[hidden] {
    display: none !important;
}

.help-card {
    width: min(560px, calc(100vw - 24px));
    background: #fff;
    border-radius: 14px;
    border: 1px solid var(--line);
    padding: 14px;
}

.help-card h3 {
    margin: 0 0 8px;
}

.help-card p {
    margin: 6px 0;
    font-size: 14px;
}

@media (max-width: 980px) {
    .editor-app {
        grid-template-columns: 1fr;
    }

    .track-panel {
        border-right: none;
        border-bottom: 1px solid var(--line);
        max-height: 42vh;
    }

    .grid {
        grid-template-columns: 1fr;
    }

    .artwork-edit-row {
        grid-template-columns: 1fr;
    }

    .artwork-preview-wrap {
        width: 100%;
        max-width: 180px;
        height: 180px;
    }

    .metric-row {
        grid-template-columns: repeat(3, minmax(90px, 1fr));
    }
}
