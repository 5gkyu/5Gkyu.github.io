:root {
    --bg: radial-gradient(120% 120% at 10% 0%, #1d2f45 0%, #101621 45%, #090c12 100%);
    --card: rgba(20, 26, 38, 0.7);
    --card-border: rgba(255, 255, 255, 0.12);
    --text: #f5f7ff;
    --muted: rgba(245, 247, 255, 0.76);
    --accent: #57c0f8;
    --danger: #f67272;
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; font-family: 'Inter', sans-serif; height: 100%; }
body { background: var(--bg); color: var(--text); }

.page-shell { display: flex; min-height: 100vh; }

.left-panel {
    width: 320px;
    background: rgba(8, 12, 19, 0.72);
    border-right: 1px solid var(--card-border);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.brand { display: flex; align-items: center; gap: 8px; }
.brand h1 { margin: 0; font-size: 20px; }
.nav-links { display: flex; gap: 8px; flex-wrap: wrap; }
.nav-links a {
    font-size: 12px;
    text-decoration: none;
    color: var(--text);
    background: rgba(255, 255, 255, 0.12);
    padding: 6px 10px;
    border-radius: 999px;
}

.create-box { display: grid; grid-template-columns: 1fr auto; gap: 8px; }
input, button {
    height: 36px;
    border-radius: 10px;
    border: 1px solid var(--card-border);
    background: rgba(255, 255, 255, 0.08);
    color: var(--text);
    padding: 0 10px;
}
button { cursor: pointer; font-weight: 600; }
button:hover { background: rgba(255, 255, 255, 0.18); }

.playlist-list {
    overflow: auto;
    border: 1px solid var(--card-border);
    border-radius: 12px;
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.playlist-item {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid transparent;
    border-radius: 8px;
    color: var(--text);
    text-align: left;
    padding: 8px 10px;
    cursor: pointer;
}
.playlist-item.active {
    border-color: var(--accent);
    background: rgba(87, 192, 248, 0.22);
}

.main-panel { flex: 1; padding: 22px; display: flex; flex-direction: column; gap: 14px; }
.main-header { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
.main-header h2 { margin: 0; font-size: 24px; }
.header-actions { display: flex; gap: 8px; }
.primary { background: rgba(87, 192, 248, 0.25); }
.danger { background: rgba(246, 114, 114, 0.2); border-color: rgba(246, 114, 114, 0.5); }

.card {
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: 14px;
    padding: 12px;
}
.card h3 { margin: 0 0 10px; font-size: 15px; }
.row { display: grid; grid-template-columns: 1fr auto; gap: 8px; }

.content-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; min-height: 0; flex: 1; }
.card { display: flex; flex-direction: column; gap: 10px; min-height: 0; }
.track-list {
    overflow: auto;
    border: 1px solid var(--card-border);
    border-radius: 10px;
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-height: 240px;
}

.playlist-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.08);
}

.playlist-item.selectable {
    cursor: pointer;
}

.playlist-item.selectable.selected {
    border-color: var(--accent);
    box-shadow: inset 0 0 0 1px rgba(87, 192, 248, 0.45);
    background: rgba(87, 192, 248, 0.16);
}

.playlist-item-art {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.playlist-item-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.playlist-item-art .material-icons-round {
    font-size: 20px;
    color: rgba(245, 247, 255, 0.9);
}

.playlist-item-info {
    flex: 1;
    min-width: 0;
}

.playlist-item-title {
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.playlist-item-artist {
    font-size: 11px;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.playlist-item-duration {
    font-size: 12px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
}

.track-sub { font-size: 11px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.playlist-item input[type="checkbox"] {
    width: 18px;
    height: 18px;
}

.playlist-list .playlist-item {
    width: 100%;
    justify-content: flex-start;
}

.playlist-list .playlist-item.active {
    border-color: var(--accent);
    box-shadow: inset 0 0 0 1px rgba(87, 192, 248, 0.45);
    background: rgba(87, 192, 248, 0.18);
}
.remove-btn {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    border: 1px solid rgba(246, 114, 114, 0.45);
    background: rgba(246, 114, 114, 0.18);
    color: #fff;
}
.status { min-height: 20px; color: var(--muted); margin: 0; }

@media (max-width: 1000px) {
    .page-shell { flex-direction: column; }
    .left-panel { width: 100%; }
    .content-grid { grid-template-columns: 1fr; }
}
