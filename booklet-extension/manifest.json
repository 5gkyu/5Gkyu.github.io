{
  "manifest_version": 3,
  "name": "Halcyon ブックマークレットランチャー",
  "version": "1.0.0",
  "description": "GitHubと自動同期し、あらゆるWebサイト（XやGitHub等）でブックマークレットを実行できる拡張機能",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Halcyon ブックマークレットランチャー",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://5gkyu.github.io/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+X",
        "mac": "Alt+X"
      },
      "description": "ブックマークレットランチャーを開く"
    }
  }
}
